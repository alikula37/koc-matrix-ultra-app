{
	# Caddy + Tailscale — local ağ + iPhone/Android dışarıdan aynı adres
	# Tailscale MagicDNS için: tailscale up + bu Caddyfile'da hostname uncomment et
	# Caddy otomatik Let's Encrypt / Tailscale cert alır (local HTTPS)
	admin off
}

# Local dev — http://localhost
:80, :443 {
	@api path /api/* /docs* /openapi.json
	handle @api {
		reverse_proxy backend:8000
	}
	handle /* {
		reverse_proxy frontend:3000
	}
	log { output stdout }
	header {
		# PWA & security
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
	}
}

# Tailscale — koc-matrix.<tailnet>.ts.net (gerçek tailnet adını yaz, uncomment et)
# koc-matrix.tail-scale.ts.net {
# 	@api path /api/* /docs* /openapi.json
# 	handle @api { reverse_proxy backend:8000 }
# 	handle /* { reverse_proxy frontend:3000 }
# 	log { output stdout }
# 	tls {
# 		get_certificate tailscale
# 	}
# }

# Prod örneği — kendi domainin varsa:
# kocmatrix.example.com {
# 	reverse_proxy frontend:3000
# }
