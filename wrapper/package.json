{
  "name": "koc-matrix-wrapper",
  "version": "1.1.0",
  "description": "Koç Matrix Ultra — Cross-platform menü çubuğu wrapper (Electron) — Docker + GHCR + auto-updater",
  "main": "main.js",
  "author": "Koç Matrix <alikula37@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/alikula37/koc-matrix-ultra-app.git"
  },
  "homepage": "https://github.com/alikula37/koc-matrix-ultra-app#readme",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac dmg",
    "dist": "electron-builder --mac --win",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.kocmatrix.ultra",
    "productName": "Koç Matrix Ultra",
    "copyright": "Copyright © 2026 Koç Matrix Ultra",
    "directories": {
      "output": "../dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../docker-compose.yml",
        "to": "docker-compose.yml"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.finance",
      "arch": [
        "x64",
        "arm64"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        "zip"
      ],
      "publisherName": "Koç Matrix Ultra"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Koç Matrix Ultra"
    },
    "dmg": {
      "sign": false,
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "alikula37",
        "repo": "koc-matrix-ultra-app",
        "private": false
      }
    ]
  }
}
