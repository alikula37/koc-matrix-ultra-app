{
  "name": "koc-matrix-ultra-app",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Koç Matrix Ultra - Trader için gelişmiş trading uygulaması",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite",
    "build": "tsc --noEmit && electron-vite build",
    "build:renderer": "vite build",
    "preview": "vite preview",
    "preview:electron": "electron-vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:legacy": "npm run dist --prefix wrapper"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.3",
    "lucide-react": "^0.468.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0",
    "electron-store": "^10.0.1",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^20.19.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.5.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1"
  },
  "build": {
    "appId": "com.kocmatrix.ultra",
    "productName": "Koç Matrix Ultra",
    "copyright": "Copyright © 2026 Koç Matrix Ultra",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "docker-compose.yml",
        "to": "docker-compose.yml"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.finance",
      "arch": [
        "x64",
        "arm64"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        "zip"
      ],
      "publisherName": "Koç Matrix Ultra"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Koç Matrix Ultra"
    },
    "dmg": {
      "sign": false,
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "alikula37",
        "repo": "koc-matrix-ultra-app",
        "private": false
      }
    ]
  }
}
