{
  "name": "koc-matrix-ultra-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Koç Matrix Ultra - Trader için gelişmiş trading uygulaması",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "dist": "npm run dist --prefix wrapper",
    "dist:mac": "npm run dist:mac --prefix wrapper",
    "dist:win": "npm run dist:win --prefix wrapper"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "lucide-react": "^0.400.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "tailwindcss": "^3.4.6",
    "postcss": "^8.4.39",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.kocmatrix.ultra",
    "productName": "Koç Matrix Ultra",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "directories": {
      "output": "dist"
    }
  }
}
